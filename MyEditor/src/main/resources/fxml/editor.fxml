<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox style="-fx-background-color: #0d1117;" xmlns="http://javafx.com" xmlns:fx="http://javafx.com">
   <children>
      <!-- Cabecera interna del editor -->
      <HBox alignment="CENTER_LEFT" style="-fx-background-color: #161b22; -fx-padding: 10 20 10 20; -fx-border-color: #30363d; -fx-border-width: 0 0 1 0;">
         <children>
            <Button onAction="#mostrarInicio" style="-fx-background-color: transparent; -fx-text-fill: #8b949e;" text="⬅" />
            <Label fx:id="lblTabName" style="-fx-text-fill: white; -fx-font-family: 'Monospaced'; -fx-padding: 0 0 0 15;" text="sin_titulo.txt" />
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
               <children>
                  <Button onAction="#guardarArchivo" style="-fx-background-color: #21262d; -fx-border-color: #30363d; -fx-border-radius: 6; -fx-text-fill: white;" text="💾 Guardar" />
               </children>
            </HBox>
         </children>
      </HBox>
      
      <!-- Espacio de Escritura (Gutter + Caja de texto) -->
      <HBox VBox.vgrow="ALWAYS">
         <children>
            <TextArea fx:id="txtLineas" editable="false" focusTraversable="false" maxWidth="50.0" prefWidth="45.0" style="-fx-control-inner-background: #0d1117; -fx-text-fill: #484f58; -fx-font-family: 'JetBrains Mono'; -fx-font-size: 14px;" text="1" />
            <TextArea fx:id="txtEditor" promptText="Comienza a escribir aquí..." style="-fx-control-inner-background: #0d1117; -fx-text-fill: #c9d1d9; -fx-font-family: 'JetBrains Mono'; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
</VBox>
