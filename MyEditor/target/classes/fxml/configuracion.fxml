<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" style="-fx-background-color: #0b0e14;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="90.0" />
   </padding>
   <children>
      <!-- Bloque centralizado con el mismo ancho de la vista de inicio -->
      <VBox alignment="CENTER" maxWidth="500.0" spacing="25.0">
         <children>
            <Label style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" text="Configuración del Editor" />
            
            <!-- Tarjeta principal de opciones -->
            <VBox spacing="22.0" style="-fx-background-color: #141824; -fx-border-color: #22283a; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 24;">
               <children>
                  <!-- Sección 1: Tipografía -->
                  <VBox spacing="12.0">
                     <children>
                        <Label style="-fx-text-fill: #3b82f6; -fx-font-size: 13px; -fx-font-weight: bold;" text="Tipografía y Tamaño" />
                        <HBox spacing="16.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-text-fill: #8b949e; -fx-font-size: 12px;" text="Fuente Mono" />
                                    <ComboBox fx:id="fontFamilySelector" maxWidth="1.7976931348623157E308" onAction="#aplicarTipografia" style="-fx-background-color: #121520; -fx-border-color: #2a3146; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: white; -fx-padding: 2;" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-text-fill: #8b949e; -fx-font-size: 12px;" text="Tamaño de fuente" />
                                    <ComboBox fx:id="fontSizeSelector" maxWidth="1.7976931348623157E308" onAction="#aplicarTipografia" style="-fx-background-color: #121520; -fx-border-color: #2a3146; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: white; -fx-padding: 2;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Sección 2: Visualización -->
                  <VBox spacing="12.0">
                     <children>
                        <Label style="-fx-text-fill: #3b82f6; -fx-font-size: 13px; -fx-font-weight: bold;" text="Opciones de visualización" />
                        <CheckBox fx:id="chkLineas" selected="true" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-cursor: hand;" text="Números de línea" />
                        <CheckBox fx:id="chkAjusteLinea" selected="true" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-cursor: hand;" text="Ajuste de línea (Word Wrap)" />
                     </children>
                  </VBox>
                  <!-- Sección 3: Cifrado -->
                  <VBox spacing="12.0">
                     <children>
                        <Label style="-fx-text-fill: #3b82f6; -fx-font-size: 13px; -fx-font-weight: bold;" text="Seguridad y Cifrado" />
                        <VBox spacing="6.0">
                           <children>
                              <Label style="-fx-text-fill: #8b949e; -fx-font-size: 12px;" text="Algoritmo de cifrado predeterminado" />
                              <ComboBox fx:id="cbAlgoritmoCifrado" maxWidth="1.7976931348623157E308" style="-fx-background-color: #121520; -fx-border-color: #2a3146; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: white; -fx-padding: 2;" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>