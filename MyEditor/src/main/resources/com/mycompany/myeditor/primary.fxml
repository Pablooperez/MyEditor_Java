<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="600.0" minWidth="900.0" prefHeight="720.0" prefWidth="1024.0" style="-fx-background-color: #0d1117;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml" fx:controller="com.mycompany.myeditor.PrimaryController">
   <left>
      <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #161b22; -fx-border-color: #30363d; -fx-border-width: 0 1 0 0;">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="25.0" />
         </padding>
         <children>
            <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 20 5;" text="&lt;/&gt; MyEditor" />
            <Button fx:id="btnArchivos" maxWidth="1.7976931348623157E308" onAction="#mostrarInicio" style="-fx-background-color: #21262d; -fx-text-fill: white; -fx-alignment: BASELINE_LEFT; -fx-padding: 10; -fx-cursor: hand;" text="📁 Archivos" />
            <Button fx:id="btnConfiguracion" maxWidth="1.7976931348623157E308" onAction="#mostrarConfiguracion" style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-alignment: BASELINE_LEFT; -fx-padding: 10; -fx-cursor: hand;" text="⚙ Configuración" />
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="vistaCentral" BorderPane.alignment="CENTER" />
   </center>
   <bottom>
      <HBox spacing="20.0" style="-fx-background-color: #161b22; -fx-padding: 6 15 6 15; -fx-border-color: #30363d; -fx-border-width: 1 0 0 0;">
         <children>
            <HBox alignment="CENTER_RIGHT" spacing="15.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblCursor" style="-fx-text-fill: #8b949e; -fx-font-size: 11px;" text="Línea 1, Columna 1" />
                  <Label style="-fx-text-fill: #8b949e; -fx-font-size: 11px;" text="|  UTF-8" />
               </children>
            </HBox>
         </children>
      </HBox>
   </bottom>
</BorderPane>